// gtacheck — Windows resources: the exe icon (Explorer, taskbar, window) and the version block.
// gtacheck.ico is generated by gen_icon.py; rc.exe compiles this in build.bat.
#pragma code_page(65001)
#include <windows.h>

1 ICON "gtacheck.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "INU Check — GTA folder checker"
			VALUE "ProductName", "INU Check"
			VALUE "FileVersion", "1.0.0.0"
			VALUE "ProductVersion", "1.0.0.0"
			VALUE "OriginalFilename", "gta_check.exe"
			VALUE "InternalName", "gtacheck"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
